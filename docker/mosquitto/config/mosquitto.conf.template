# Minimal Mosquitto configuration for PiSelfhosting

# Enable persistence
persistence true
persistence_location /mosquitto/data/

# Log settings
log_dest file /mosquitto/log/mosquitto.log
log_type error
log_type warning
log_type notice
log_type information
connection_messages true
log_timestamp true

# Standard listener on port 1883
port 1883

# Allow anonymous connections for easier setup, can be set to false later
allow_anonymous true

