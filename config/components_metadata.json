{
  "_piselfhosting": {
    "components_order": [
      "pi-hole",
      "adguard-home",
      "homarr",
      "heimdall",
      "homer",
      "organizr",
      "traefik",
      "nginx-proxy-manager",
      "gitlab",
      "conduit",
      "frigate",
      "homeassistant",
      "jellyfin",
      "nextcloud",
      "portainer",
      "radarr",
      "sabnzbd",
      "scrypted",
      "sonarr",
      "unbound",
      "unifi-controller",
      "uptime-kuma",
      "vaultwarden",
      "web-notepad",
      "zigbee2mqtt",
      "qbittorrent",
      "piselfhosting-backup-tool",
      "piselfhosting-service-maintenance"
    ],
    "default_group": "general",
    "group_order": [
      "dns_blocker",
      "dashboard",
      "reverse_proxy",
      "git_server",
      "general",
      "System Tools"
    ],
    "group_rules": {
      "System Tools": {
        "is_exclusive": false,
        "name": "System Tools"
      },
      "dashboard": {
        "is_exclusive": true,
        "name": "Dashboard"
      },
      "dns_blocker": {
        "is_exclusive": true,
        "name": "DNS Blocker"
      },
      "general": {
        "is_exclusive": false,
        "name": "General Components"
      },
      "git_server": {
        "is_exclusive": true,
        "name": "Git Server"
      },
      "reverse_proxy": {
        "is_exclusive": true,
        "name": "Reverse Proxy"
      }
    }
  },
  "components": {
    "adguard-home": {
      "description": "Network-wide ad & tracker blocking DNS server. An alternative to Pi-hole.",
      "group": "dns_blocker",
      "has_ui": true,
      "image_name": "adguard/adguardhome",
      "name": "AdGuard Home",
      "project_url": "https://github.com/AdguardTeam/AdGuardHome",
      "protocol": "http",
      "ui_port": 3000,
      "version": "latest"
    },
    "conduit": {
      "description": "A lightweight, next-generation Matrix homeserver, ideal for Raspberry Pi.",
      "group": "general",
      "has_ui": false,
      "image_name": "matrixconduit/matrix-conduit",
      "name": "Conduit (Matrix Server)",
      "project_url": "https://conduit.rs/",
      "version": "latest"
    },
    "frigate": {
      "description": "NVR with real-time object detection for IP cameras.",
      "group": "general",
      "has_ui": true,
      "image_name": "blakeblackshear/frigate",
      "name": "Frigate",
      "project_url": "https://docs.frigate.video/",
      "protocol": "http",
      "ui_port": 5000,
      "version": "stable"
    },
    "gitlab": {
      "description": "A complete DevOps platform for project planning, source code management, CI/CD, and monitoring.",
      "group": "git_server",
      "has_ui": true,
      "image_name": "gitlab/gitlab-ce",
      "name": "GitLab",
      "project_url": "https://about.gitlab.com/",
      "protocol": "http",
      "ui_port": 10080,
      "version": "latest"
    },
    "heimdall": {
      "description": "A simple and elegant application dashboard.",
      "group": "dashboard",
      "has_ui": true,
      "image_name": "lscr.io/linuxserver/heimdall",
      "name": "Heimdall",
      "project_url": "https://heimdall.site/",
      "protocol": "http",
      "ui_port": 8090,
      "version": "latest"
    },
    "homarr": {
      "default": true,
      "description": "A simple, yet powerful dashboard for your server.",
      "group": "dashboard",
      "has_configuration": true,
      "has_ui": true,
      "image_name": "ghcr.io/ajnart/homarr",
      "name": "Homarr",
      "project_url": "https://homarr.dev/",
      "protocol": "http",
      "required_variables": [
        {
          "default": 7575,
          "description": "The external port to access the Homarr web UI.",
          "id": "HOMARR_HTTP_PORT",
          "label": "Homarr HTTP Port",
          "required": true,
          "type": "port"
        },
        {
          "default": "{{ CONFIG_BASE_PATH }}/homarr",
          "description": "The path to the Homarr configuration files.",
          "id": "HOMARR_CONFIG_PATH",
          "label": "Homarr Config Path",
          "required": true,
          "type": "hidden"
        }
      ],
      "ui_port": 7575,
      "ui_port_variable": "HOMARR_HTTP_PORT",
      "version": "latest"
    },
    "homeassistant": {
      "description": "Open source home automation that puts local control and privacy first.",
      "group": "general",
      "has_ui": true,
      "image_name": "homeassistant/home-assistant",
      "name": "Home Assistant",
      "project_url": "https://www.home-assistant.io/",
      "protocol": "http",
      "ui_port": 8123,
      "version": "stable"
    },
    "homer": {
      "description": "A dead simple, static homepage for your server.",
      "group": "dashboard",
      "has_ui": true,
      "image_name": "b4bz/homer",
      "name": "Homer",
      "project_url": "https://github.com/bastienwirtz/homer",
      "protocol": "http",
      "ui_port": 8085,
      "version": "latest"
    },
    "jellyfin": {
      "description": "A Free Software Media System that puts you in control of your media.",
      "group": "general",
      "has_ui": true,
      "image_name": "lscr.io/linuxserver/jellyfin",
      "name": "Jellyfin",
      "project_url": "https://jellyfin.org/",
      "protocol": "http",
      "ui_port": 8096,
      "version": "latest"
    },
    "nextcloud": {
      "depends_on": "mariadb",
      "description": "The self-hosted productivity platform that keeps you in control.",
      "group": "general",
      "has_ui": true,
      "image_name": "lscr.io/linuxserver/nextcloud",
      "name": "Nextcloud",
      "project_url": "https://nextcloud.com/",
      "protocol": "http",
      "ui_port": 4430,
      "version": "latest"
    },
    "nginx-proxy-manager": {
      "depends_on": [
        "mariadb"
      ],
      "description": "User-friendly interface for managing Nginx proxy hosts and SSL certificates.",
      "group": "reverse_proxy",
      "has_configuration": false,
      "has_ui": true,
      "image_name": "jc21/nginx-proxy-manager",
      "name": "Nginx Proxy Manager",
      "project_url": "https://nginxproxymanager.com/",
      "protocol": "http",
      "required_variables": [
        {
          "id": "NEW_VARIABLE",
          "label": "New Variable",
          "type": "string"
        },
        {
          "id": "NEW_VARIABLE2",
          "label": "New Variable",
          "type": "string"
        }
      ],
      "ui_port": 81,
      "version": "latest"
    },
    "organizr": {
      "description": "A full-featured server organizer with a tabbed interface.",
      "group": "dashboard",
      "has_ui": true,
      "image_name": "lscr.io/linuxserver/organizr",
      "name": "Organizr",
      "project_url": "https://organizr.app/",
      "protocol": "http",
      "ui_port": 8095,
      "version": "latest"
    },
    "pi-hole": {
      "depends_on": [],
      "description": "A network-wide ad blocker that acts as a DNS sinkhole.Hvh",
      "group": "dns_blocker",
      "has_configuration": true,
      "has_ui": true,
      "image_name": "pihole/pihole",
      "name": "Pi-hole",
      "project_url": "https://pi-hole.net/",
      "protocol": "http",
      "required_variables": [
        {
          "default": "pi",
          "description": "A strong password for the web UI. Required for a clean installation.",
          "id": "PIHOLE_WEB_PASSWORD",
          "label": "Pi-hole Admin Password",
          "required": "clean-install",
          "type": "password"
        },
        {
          "default": 8088,
          "description": "The external HTTP port to access the Pi-hole web UI.",
          "id": "PIHOLE_WEB_PORT",
          "label": "Pi-hole Web Interface Port",
          "required": false,
          "type": "port"
        },
        {
          "default": 53,
          "description": "The external port for DNS queries. Must be 53 for most use cases.",
          "id": "PIHOLE_DNS_PORT",
          "label": "Pi-hole DNS Port",
          "required": false,
          "type": "port"
        }
      ],
      "ui_port": 80,
      "ui_port_variable": "PIHOLE_WEB_PORT",
      "version": "latest"
    },
    "piselfhosting-backup-tool": {
      "default": false,
      "depends_on": [],
      "description": "A simple tool to back up and restore all your persistent service data.",
      "group": "System Tools",
      "has_configuration": false,
      "has_ui": true,
      "image_name": "henkvanhoek/piselfhosting-backup-tool",
      "name": "Backup & Restore Tool",
      "project_url": "https://github.com/HenkVanHoek/PiSelfhosting",
      "protocol": "http",
      "required_variables": [],
      "ui_port": 9901,
      "version": "0.1.0"
    },
    "piselfhosting-service-maintenance": {
      "default": false,
      "depends_on": [],
      "description": "Monitor status, updates and vulnerabilities.",
      "group": "System Tools",
      "has_configuration": false,
      "has_ui": true,
      "image_name": "henkvanhoek/piselfhosting-service-maintenance",
      "name": "Service Maintenance",
      "project_url": "https://github.com/HenkVanHoek/PiSelfhosting",
      "protocol": "http",
      "ui_port": 9999,
      "version": "0.1.0"
    },
    "portainer": {
      "default": true,
      "depends_on": [],
      "description": "A powerful management UI for Docker environments. ",
      "group": "general",
      "has_configuration": true,
      "has_ui": true,
      "image_name": "portainer/portainer-ce",
      "name": "Portainer",
      "post_install_restart_option": true,
      "project_url": "https://www.portainer.io/",
      "protocol": "https",
      "required_variables": [
        {
          "default": "lts",
          "description": "The Docker image tag for Portainer CE. 'lts' (Long-Term Support) is recommended for stability.",
          "id": "PORTAINER_IMAGE_TAG",
          "label": "Portainer Version Tag",
          "type": "string"
        },
        {
          "default": "9443",
          "description": "The external HTTPS port for the Portainer web UI.",
          "id": "PORTAINER_HTTPS_PORT",
          "label": "Portainer Web Port (HTTPS)",
          "type": "port"
        },
        {
          "default": "8000",
          "description": "The external port for the Portainer Edge Agent tunnel server. HvH",
          "id": "PORTAINER_EDGE_PORT",
          "label": "Portainer Edge Agent Port",
          "type": "string"
        }
      ],
      "ui_port": 9443,
      "ui_port_variable": "PORTAINER_HTTPS_PORT",
      "version": "lts"
    },
