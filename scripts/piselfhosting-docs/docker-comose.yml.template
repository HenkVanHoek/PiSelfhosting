# scripts/templates/piselfhosting-docs/docker-compose.yml.template
services:
  piselfhosting-docs:
    image: nginx:alpine
    container_name: piselfhosting-docs
    restart: unless-stopped
    volumes:
      - ./html:/usr/share/nginx/html:ro # Mount the HTML content
    # Expose port 80 internally, Nginx Proxy Manager will handle external access
    expose:
      - "80"
    networks:
      - piselfhosting_net

networks:
  piselfhosting_net:
    external: true

